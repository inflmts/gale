#
# lf configuration file
#
# Documentation:
#   - lf(1)
#   - https://github.com/gokcehan/lf
#

#---- OPTIONS

# set $IFS to newline in subshells
set ifs "\n"

set nopreview
set ratios 1:4
set cursorparentfmt "\033[4m"

# leave a few lines around cursor
set scrolloff 3

# show hidden files
set hidden

# search while typing
set incsearch

# automatically refresh files every 3 seconds
# lf also now has a 'watch' option that uses fsnotify.
# May want to look into that.
set period 3

# time formats
set infotimefmtnew "Jan 02 15:04"
set infotimefmtold "Jan 02, 2006"
set timefmt "Mon 01/02/2006 03:04 PM"

# draw box around directory listing
set drawbox
set borderfmt "\033[38;5;240m"

# enable mouse
set mouse

# New versions of lf use a Go template to configure the ruler.
# See the RULER section in lf(1).
#
# Syntax: https://pkg.go.dev/text/template
# Example: https://github.com/gokcehan/lf/blob/master/etc/ruler.default

set rulerfile ~/.config/lf/ruler

setlocal ~/electric/core reverse
setlocal ~/electric/queue sortby time

#---- KEYBINDINGS

# remove some default commands
map zh
map zr
map zn
map zs
map zt
map za

map sn
map ss
map st
map sa
map sc
map se

# scroll commands
map <backspace> page-up
map <backspace2> page-up
map <space> page-down
map <c-j> scroll-down
map <c-k> scroll-up

# use <tab> to select files
map <tab> :toggle; down

# sort commands
map O set sortby natural
map S set sortby size
map T set sortby time
map E set sortby ext
map I set reverse!

# other commands
map g/ cd /
map gs !git status
map g<c-a> !git add -Av && git status
map gc !git commit
map ~ cd
map . set hidden!
map o push &<space>"$f"<c-a>
map f filter
map F setfilter
map <enter> open
map <c-t> &exec foot
map <a-b> &exec open --browser "$f"
map D &exec dragon-drop -x $fx

cmap <c-x> cmd-interrupt
