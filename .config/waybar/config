//
// Waybar configuration file
// vim:ft=jsonc
//
// Documentation:
//   - waybar(5)
//   - waybar-<module>(5)
//   - https://github.com/Alexays/Waybar
//

{
  "layer": "top",
  "position": "bottom",
  "height": 25,
  "margin-bottom": -25,
  "exclusive": false,

  // Left
  "modules-left": [
    "wlr/taskbar"
  ],
  "wlr/taskbar": {
    "on-click": "minimize-raise",
    "tooltip-format": "{title}"
  },

  // Right
  "modules-right": [
    "network",
    "bluetooth",
    "cpu",
    "memory",
    "pulseaudio",
    "backlight",
    "battery",
    "clock"
  ],
  "network": {
    "format": "<span size='smaller' alpha='55%'>NET</span> {ifname}",
    "format-wifi": "<span size='smaller' alpha='55%'>WIFI</span> {ipaddr}",
    "format-ethernet": "<span size='smaller' alpha='55%'>ETH</span> {ipaddr}",
    "format-disconnected": "no internet",
    "format-disabled": "<span size='smaller' alpha='55%'>WIFI</span> disabled",
    "tooltip-format-wifi": "{ifname} / {essid} [{signalStrength}%]"
  },
  "bluetooth": {
    "format": "<span size='smaller' alpha='55%'>BT</span> {status}",
    "format-connected": "<span size='smaller' alpha='55%'>BT</span> {device_alias}",
    "format-no-controller": "",
    "tooltip-format-connected": "{device_alias}",
    "tooltip-format-connected-battery": "{device_alias} [{device_battery_percentage}%]",
    "max-width": 24
  },
  "cpu": {
    "interval": 5,
    "format": "<span size='smaller' alpha='55%'>CPU</span> {usage}%"
  },
  "memory": {
    "interval": 5,
    "format": "<span size='smaller' alpha='55%'>MEM</span> {used}G"
  },
  "pulseaudio": {
    "format": "<span size='smaller' alpha='55%'>VOL</span> {volume}%",
    "format-muted": "<span size='smaller' alpha='55%'>VOL</span> <s>{volume}%</s>"
  },
  "backlight": {
    "interval": 5,
    "format": "<span size='smaller' alpha='55%'>BR</span> {percent}%"
  },
  "battery": {
    "format": "<span size='smaller' alpha='55%'>CH</span> {capacity}%"
  },
  "clock": {
    "format": "<span size='smaller' alpha='55%'>DATE</span> {:%a %b %d %Y %I:%M %p}",
    "tooltip-format": "Zero to infinity"
  }
}
