#!/bin/sh

pick_file() {
  # NOTE: this is an en dash -------v
  file=$(mpc -f '%file%\t[[%artist% – ]%title%|%file%]' listall |
    fuzzel -d -p "$1: " -w 60 --accept-nth=1 --with-nth=2 --only-match)
}

case $1 in
play)
  pick_file play &&
  if index=$(mpc -f '%file%' playlist | grep -Fxn "$file"); then
    mpc -q play "${index%%:*}"
  else
    mpc -q add "$file" &&
    last=$(mpc status '%length%') &&
    mpc -q play "$last"
  fi
  ;;
load)
  file=$(mpc lsplaylists | fuzzel -d -p 'load: ') &&
  mpc -q clear &&
  mpc -q load "$file" &&
  mpc -q play
  ;;
insert)
  pick_file insert &&
  if index=$(mpc -f '%file%' playlist | grep -Fxn "$file"); then
    mpc -q del "${index%%:*}"
  fi &&
  mpc -q insert "$file"
  ;;
*)
  echo >&2 "usage: ${0##*/} play|load|insert"
  exit 2
  ;;
esac
