#!/bin/sh
# labwc wrapper

if [ -z "$XDG_RUNTIME_DIR" ]; then
  echo >&2 "$0: \$XDG_RUNTIME_DIR is not set"
  exit 1
fi

cd

if [ -z "$DBUS_SESSION_BUS_ADDRESS" ]; then
  dbus_dir="$XDG_RUNTIME_DIR/gale-dbus/"
  dbus_sock="$dbus_dir/sock"
  dbus_address="unix:path=$dbus_sock"
  if mkdir "$dbus_dir" > /dev/null 2>&1; then
    dbus-daemon --session --fork --nopidfile --address="$dbus_address"
  fi
  export DBUS_SESSION_BUS_ADDRESS="$dbus_address"
fi

exec labwc <&- > /dev/null 2>&1
